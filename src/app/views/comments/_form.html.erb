<div class="comment-form"
  id="<%= "comment-form" + (defined?(initial_replied) ? "-#{initial_replied}" : "") %>"
  data-controller="turnstile"
  data-turnstile-environment-value="<%= Rails.env %>"
  data-turnstile-sitekey-value="<%= ENV.fetch("CLOUDFLARE_TURNSTILE_SITE_KEY") %>">
  <%= form_with(model: comment, url: url) do |f| %>
    <%= render 'shared/error_messages', instead: comment %>
    <%= f.hidden_field :post_aid, value: post_aid %>
    <% if (defined? initial_replied) %>
      <div>
        <%= f.hidden_field :replied_aid, value: initial_replied %>
        コメントID:<%= initial_replied %>のスレッドへ返信
      </div>
    <% end %>
    <% if @current_account %>
      <div><%= @current_account.name %>としてコメント</div>
    <% end %>
    <%= f.label :name, '名前' %>
    <%= f.text_field :name, placeholder: '名前' %>
    <br />
    <%= f.label :content, 'コメント' %>
    <%= f.text_area :content, placeholder: 'コメント' %>
    <br />
    <%= f.label :address, 'アドレス(非公開)' %>
    <%= f.text_field :address, placeholder: 'アドレス(非公開)' %>
    <br />
    <div class="cf-turnstile" data-turnstile-target="widget"></div>
    <br />
    <p>投稿すると、当サイトの利用規約・ポリシー・免責事項に同意したとみなされます。</p>
    <p>管理者に承認されると一般掲示されます。</p>
    <%= f.submit "投稿", data: { turnstile_target: "submit" }, disabled: true %>
  <% end %>
</div>
